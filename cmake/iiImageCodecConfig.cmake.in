@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(iiVisualCodec 0.2 CONFIG COMPONENTS Image)
if(NOT TARGET iiImageCodec::iiImageCodec)
    add_library(iiImageCodec::iiImageCodec INTERFACE IMPORTED)
    set_property(TARGET iiImageCodec::iiImageCodec PROPERTY INTERFACE_LINK_LIBRARIES iiVisualCodec::Image)
endif()
check_required_components(iiImageCodec)
