@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux" AND NOT "@ANDROID@")
    find_dependency(PkgConfig)
    pkg_check_modules(ColorManagement REQUIRED IMPORTED_TARGET lcms2)
endif()
set(_iiimage_saved_framework "${CMAKE_FIND_FRAMEWORK}")
set(CMAKE_FIND_FRAMEWORK LAST)
find_dependency(PNG 1.6)
set(CMAKE_FIND_FRAMEWORK "${_iiimage_saved_framework}")
unset(_iiimage_saved_framework)
find_dependency(JPEG)
find_dependency(ZLIB)
find_dependency(WebP 1 CONFIG)
find_dependency(TIFF 4.5)
include("${CMAKE_CURRENT_LIST_DIR}/iiImageCodecTargets.cmake")
check_required_components(iiImageCodec)
