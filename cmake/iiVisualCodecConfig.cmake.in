@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(_iivisual_available @IIVISUALCODEC_COMPONENTS@)
if(NOT iiVisualCodec_FIND_COMPONENTS)
    set(iiVisualCodec_FIND_COMPONENTS ${_iivisual_available})
endif()
set(_iivisual_requested ${iiVisualCodec_FIND_COMPONENTS})
if("Asset3D" IN_LIST _iivisual_requested OR "CAD" IN_LIST _iivisual_requested OR "USD" IN_LIST _iivisual_requested)
    list(APPEND _iivisual_requested Geometry)
endif()
if("OpenCV" IN_LIST _iivisual_requested)
    list(APPEND _iivisual_requested Vision)
endif()
if("Video" IN_LIST _iivisual_requested OR "USD" IN_LIST _iivisual_requested)
    list(APPEND _iivisual_requested Spatial)
endif()
if("Spatial" IN_LIST _iivisual_requested OR "Vision" IN_LIST _iivisual_requested OR "Geometry" IN_LIST _iivisual_requested)
    list(APPEND _iivisual_requested Image)
endif()
if("Image" IN_LIST _iivisual_requested)
    if("@CMAKE_SYSTEM_NAME@" STREQUAL "Linux" AND NOT "@ANDROID@")
        find_dependency(PkgConfig)
        pkg_check_modules(ColorManagement REQUIRED IMPORTED_TARGET lcms2)
    endif()
    find_dependency(PNG 1.6)
    find_dependency(JPEG)
    find_dependency(ZLIB)
    find_dependency(WebP 1 CONFIG)
    find_dependency(TIFF 4.5)
    include("${CMAKE_CURRENT_LIST_DIR}/iiVisualCodecImageTargets.cmake")
    # FindPNG can select a non-system macOS framework. Its -F search path is
    # not a runtime search path, so propagate the discovered framework parent
    # to consumers rather than depending on a shell-specific DYLD override.
    if(APPLE AND TARGET PNG::PNG)
        set(_iivisual_png_framework_dirs)
        foreach(_iivisual_location_property IN ITEMS IMPORTED_LOCATION IMPORTED_LOCATION_RELEASE
                IMPORTED_LOCATION_DEBUG IMPORTED_LOCATION_RELWITHDEBINFO IMPORTED_LOCATION_MINSIZEREL)
            get_target_property(_iivisual_png_location PNG::PNG ${_iivisual_location_property})
            if(_iivisual_png_location MATCHES "^(.*)/[^/]+\\.framework(/.*)?$")
                list(APPEND _iivisual_png_framework_dirs "${CMAKE_MATCH_1}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES _iivisual_png_framework_dirs)
        get_target_property(_iivisual_existing_png_dirs iiVisualCodec::Image _IIVISUAL_PNG_FRAMEWORK_DIRS)
        if(NOT _iivisual_existing_png_dirs)
            set(_iivisual_existing_png_dirs)
        endif()
        foreach(_iivisual_png_dir IN LISTS _iivisual_png_framework_dirs)
            if(NOT _iivisual_png_dir IN_LIST _iivisual_existing_png_dirs)
                set_property(TARGET iiVisualCodec::Image APPEND PROPERTY INTERFACE_LINK_OPTIONS
                    "LINKER:SHELL:-rpath \"${_iivisual_png_dir}\"")
                list(APPEND _iivisual_existing_png_dirs "${_iivisual_png_dir}")
            endif()
        endforeach()
        set_property(TARGET iiVisualCodec::Image PROPERTY _IIVISUAL_PNG_FRAMEWORK_DIRS "${_iivisual_existing_png_dirs}")
    endif()
endif()
if("Spatial" IN_LIST _iivisual_requested)
    include("${CMAKE_CURRENT_LIST_DIR}/iiVisualCodecSpatialTargets.cmake")
endif()
if("Vision" IN_LIST _iivisual_requested)
    include("${CMAKE_CURRENT_LIST_DIR}/iiVisualCodecVisionTargets.cmake")
endif()
if("Geometry" IN_LIST _iivisual_requested)
    include("${CMAKE_CURRENT_LIST_DIR}/iiVisualCodecGeometryTargets.cmake")
endif()
foreach(_iivisual_component IN LISTS iiVisualCodec_FIND_COMPONENTS)
    if(_iivisual_component IN_LIST _iivisual_available)
        set(iiVisualCodec_${_iivisual_component}_FOUND TRUE)
    else()
        set(iiVisualCodec_${_iivisual_component}_FOUND FALSE)
    endif()
endforeach()
if("OpenCV" IN_LIST _iivisual_requested AND "OpenCV" IN_LIST _iivisual_available)
    find_dependency(OpenCV 4.14 CONFIG COMPONENTS core imgproc features2d video)
    include("${CMAKE_CURRENT_LIST_DIR}/iiVisualCodecOpenCVTargets.cmake")
endif()
if("Video" IN_LIST _iivisual_requested AND "Video" IN_LIST _iivisual_available)
    find_dependency(PkgConfig)
    pkg_check_modules(VisualFFmpeg REQUIRED IMPORTED_TARGET libavformat>=62 libavcodec>=62 libavutil>=60 libswscale>=9)
    include("${CMAKE_CURRENT_LIST_DIR}/iiVisualCodecVideoTargets.cmake")
endif()
if("USD" IN_LIST _iivisual_requested AND "USD" IN_LIST _iivisual_available)
    find_dependency(pxr CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/iiVisualCodecUSDTargets.cmake")
endif()
if("Asset3D" IN_LIST _iivisual_requested AND "Asset3D" IN_LIST _iivisual_available)
    find_dependency(assimp 6 CONFIG)
    include("${CMAKE_CURRENT_LIST_DIR}/iiVisualCodecAsset3DTargets.cmake")
endif()
if("CAD" IN_LIST _iivisual_requested AND "CAD" IN_LIST _iivisual_available)
    find_dependency(OpenCASCADE 8.0.1 EXACT CONFIG COMPONENTS FoundationClasses ModelingData ModelingAlgorithms Visualization ApplicationFramework DataExchange)
    include("${CMAKE_CURRENT_LIST_DIR}/iiVisualCodecCADTargets.cmake")
endif()
if(NOT TARGET iiVisualCodec::iiVisualCodec)
    add_library(iiVisualCodec::iiVisualCodec INTERFACE IMPORTED)
endif()
foreach(_iivisual_component IN LISTS iiVisualCodec_FIND_COMPONENTS)
    if(iiVisualCodec_${_iivisual_component}_FOUND)
        set_property(TARGET iiVisualCodec::iiVisualCodec APPEND PROPERTY INTERFACE_LINK_LIBRARIES iiVisualCodec::${_iivisual_component})
    endif()
endforeach()
check_required_components(iiVisualCodec)
